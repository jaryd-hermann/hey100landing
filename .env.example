# Provisioned automatically by the Neon integration (`vercel env pull .env.local` writes the real values)
DATABASE_URL=
# Secret for GET /api/export (CSV download of the waitlist). Set in Vercel env + .env.local
ADMIN_KEY=
# Provisioned automatically by the Resend integration
RESEND_API_KEY=
# Where new-signup pings are sent
NOTIFY_TO=
# Optional sender override; needs a verified Resend domain. Defaults to onboarding@resend.dev,
# which can only deliver to the address that owns the Resend account.
NOTIFY_FROM=
